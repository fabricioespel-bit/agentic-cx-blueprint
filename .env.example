# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Traces OpenTelemetry só com metadados para o Cloud Trace (P6.2). O texto da conversa
# nunca vai nos spans. Exige a API de telemetria e o local padrão dos buckets de
# observabilidade configurado antes do primeiro trace.
EXPORTAR_TRACES=false
# Auditoria só no diário local, sem Cloud Storage nem BigQuery (o teste de integração
# liga sozinho). Não use fora de teste: o turno some da trilha oficial.
# AUDITORIA_NA_NUVEM=false
# Caminho do diário local (padrão: artifacts/auditoria/diario.jsonl).
# AUDITORIA_DIARIO=
